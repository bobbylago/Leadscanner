# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# App
# Canonical origin. Used for SEO, Stripe redirects, sitemap, robots, and OG images.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional extra secret for hashing free-account abuse guard claims.
SIGNUP_GUARD_SALT=replace-with-random-secret

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_STARTER_PRICE_ID=replace-with-starter-price-id
STRIPE_PRO_PRICE_ID=replace-with-pro-price-id
STRIPE_AGENCY_PRICE_ID=replace-with-agency-price-id

# Gemini AI outreach
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google Places lead source
# Server-only; do not expose as NEXT_PUBLIC.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
